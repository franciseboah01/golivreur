# ═══════════════════════════════════════════════════════════════════════════════
# GoLivreur v5.0 — Variables d'environnement
# ═══════════════════════════════════════════════════════════════════════════════
#
# INSTRUCTIONS :
#   1. Copiez ce fichier : cp .env.example .env
#   2. Remplissez toutes les valeurs marquées CHANGE_ME
#   3. Les valeurs secrètes sont dans Bitwarden (partagé entre Fondateur et Lead Dev)
#   4. Ne commitez JAMAIS le fichier .env dans Git
#
# ═══════════════════════════════════════════════════════════════════════════════

# ── Application ────────────────────────────────────────────────────────────────
APP_NAME=GoLivreur
APP_ENV=local                    # local | staging | production
APP_KEY=                         # Généré automatiquement par: php artisan key:generate
APP_DEBUG=true                   # OBLIGATOIREMENT false en production
APP_URL=http://localhost:8000    # En production: https://golivreur.ci

APP_LOCALE=fr
APP_TIMEZONE=Africa/Abidjan

# ── Base de données PostgreSQL 16 ──────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1                # En Docker: golivreur_db
DB_PORT=5432
DB_DATABASE=golivreur_dev        # Production: golivreur_prod / Staging: golivreur_staging
DB_USERNAME=golivreur_user
DB_PASSWORD=CHANGE_ME            # Récupérer dans Bitwarden > GoLivreur > PostgreSQL

# ── Redis 7 (Cache + Queues + Sessions) ───────────────────────────────────────
REDIS_HOST=127.0.0.1             # En Docker: golivreur_redis
REDIS_PORT=6379
REDIS_DB=0                       # Production: 0 / Staging: 1
REDIS_PASSWORD=null              # Laisser null si Redis local sans auth

# ── JWT Authentication ─────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME             # Généré par: php artisan jwt:secret
JWT_TTL=60                       # Durée access token en minutes (1 heure)
JWT_REFRESH_TTL=10080            # Durée refresh token en minutes (7 jours)
JWT_ALGO=HS256

# ── Laravel Reverb (WebSocket GPS temps réel) ──────────────────────────────────
REVERB_APP_ID=golivreur
REVERB_APP_KEY=CHANGE_ME         # Générer: openssl rand -hex 16
REVERB_APP_SECRET=CHANGE_ME      # Générer: openssl rand -hex 32
REVERB_HOST=localhost            # Production: golivreur.ci
REVERB_PORT=8080
REVERB_SCHEME=http               # Production: https

# Côté Flutter — même valeurs
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ── Queues Redis + Horizon ─────────────────────────────────────────────────────
QUEUE_CONNECTION=redis
# Queues : high (paiements) | default (FCM, SMS) | low (GPS)
HORIZON_ENABLED=true
HORIZON_MEMORY_LIMIT=128         # MB par worker

# ── Stockage photos colis & DigitalOcean Spaces / S3 ──────────────────────────
FILESYSTEM_DISK=local            # Production: s3 (ou parcel_photos en local privé)
PARCEL_PHOTOS_DISK=parcel_photos # local privé: parcel_photos | cloud privé: s3
DO_SPACES_KEY=CHANGE_ME          # Récupérer dans Bitwarden > GoLivreur > DO Spaces
DO_SPACES_SECRET=CHANGE_ME
DO_SPACES_REGION=fra1
DO_SPACES_BUCKET=golivreur
DO_SPACES_ENDPOINT=https://fra1.digitaloceanspaces.com
DO_SPACES_CDN_ENDPOINT=https://golivreur.fra1.cdn.digitaloceanspaces.com
# Variables S3/Spaces lues par config/filesystems.php (nécessite league/flysystem-aws-s3-v3 si PARCEL_PHOTOS_DISK=s3)
AWS_ACCESS_KEY_ID="${DO_SPACES_KEY}"
AWS_SECRET_ACCESS_KEY="${DO_SPACES_SECRET}"
AWS_DEFAULT_REGION="${DO_SPACES_REGION}"
AWS_BUCKET="${DO_SPACES_BUCKET}"
AWS_URL=
AWS_ENDPOINT="${DO_SPACES_ENDPOINT}"
AWS_USE_PATH_STYLE_ENDPOINT=false

# ── Hub2 / CinetPay (Paiement Orange Money) ────────────────────────────────────
HUB2_API_KEY=CHANGE_ME           # Récupérer dans Bitwarden > GoLivreur > Hub2
HUB2_SECRET=CHANGE_ME
HUB2_WEBHOOK_SECRET=CHANGE_ME   # CRITIQUE: utilisé pour validation HMAC webhooks
HUB2_ENV=sandbox                 # sandbox | production
HUB2_BASE_URL=https://api.hub2.io

# ── Passerelle SMS (OTP + codes destinataire GoColis) ────────────────────────
SMS_DRIVER=log                   # local|testing|staging: log | production: yellika
YELLIKA_API_TOKEN=CHANGE_ME      # Récupérer dans Bitwarden > GoLivreur > Yellika
YELLIKA_SENDER_ID=GoLivreur      # Sender ID validé sur le compte Yellika

# Seuils d'alerte consommation SMS — alertes envoyées à l'admin quand atteints
SMS_MONTHLY_ALERT_THRESHOLD=2500
SMS_ALERT_EMAIL=francis@golivreur.ci

# ── Google Maps API ────────────────────────────────────────────────────────────
GOOGLE_MAPS_KEY=CHANGE_ME        # Récupérer dans Bitwarden > GoLivreur > Google

# ── OpenWeatherMap (Mode Pluie automatique) ────────────────────────────────────
OPENWEATHERMAP_KEY=CHANGE_ME     # Plan gratuit suffit (1000 appels/jour, toutes les 15min)
OPENWEATHERMAP_CITY=Daloa
OPENWEATHERMAP_COUNTRY_CODE=CI
WEATHER_CHECK_INTERVAL_MINUTES=15

# ── Firebase (FCM Push + Crashlytics) ─────────────────────────────────────────
FIREBASE_CREDENTIALS=/var/www/production/storage/firebase-service-account.json
# Fichier JSON téléchargé depuis Firebase Console > Paramètres > Comptes de service
# NE PAS commiter ce fichier — le stocker sur le serveur uniquement

# ── Sentry (Monitoring erreurs) ────────────────────────────────────────────────
SENTRY_LARAVEL_DSN=              # Laisser vide en local, remplir en staging/production
# Format: https://XXXX@oXXXX.ingest.sentry.io/XXXX
SENTRY_TRACES_SAMPLE_RATE=0.1   # 10% des transactions tracées

# ── Mail (Alertes admin) ───────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME          # noreply@golivreur.ci
MAIL_PASSWORD=CHANGE_ME          # Mot de passe application Gmail (Bitwarden)
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@golivreur.ci
MAIL_FROM_NAME="GoLivreur"

# Email des alertes admin (webhook invalide, erreurs critiques, budget SMS)
ADMIN_ALERT_EMAIL=francis@golivreur.ci

# ── Sécurité & CORS ────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8080,https://golivreur.ci"

# ── Filament Admin ─────────────────────────────────────────────────────────────
FILAMENT_PATH=admin              # URL: /admin

# ── Scramble (Documentation OpenAPI auto-générée) ──────────────────────────────
SCRAMBLE_DOCS_PATH=docs          # URL: /docs
SCRAMBLE_DOCS_AUTH_ENABLED=true  # Protection de la doc en production

# ── Backup (Script automatique) ────────────────────────────────────────────────
BACKUP_ENABLED=true
BACKUP_DAILY_HOUR=3              # 3h du matin
BACKUP_RETENTION_DAYS=30
BACKUP_WEEKLY_RETENTION_MONTHS=6
