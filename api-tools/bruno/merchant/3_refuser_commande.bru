meta {
  name: 3. Refuser une commande
  type: http
  seq: 3
}

post {
  url: {{base_url}}/merchant/orders/{{order_id}}/refuse
  body: json
  auth: bearer
}

auth:bearer {
  token: {{jwt_token_merchant}}
}

body:json {
  {
    "raison": "Rupture de stock sur un des produits commandés."
  }
}

assert {
  res.status: eq 200
  res.body.succes: eq true
}

tests {
  test("Statut passe à refused", function() {
    expect(res.body.donnees.status).to.equal("refused");
  });
}

docs {
  ⚠️ Utiliser cette requête UNIQUEMENT sur une commande différente
  de celle déjà acceptée (sinon erreur 422 "ne peut plus être refusée").
}
