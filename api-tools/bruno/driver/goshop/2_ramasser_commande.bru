meta {
  name: 2. Ramasser la commande
  type: http
  seq: 2
}

post {
  url: {{base_url}}/driver/orders/{{order_id}}/pickup
  auth: bearer
}

auth:bearer {
  token: {{jwt_token_driver}}
}

assert {
  res.status: eq 200
  res.body.succes: eq true
}

tests {
  test("Statut passe à picked_up", function() {
    expect(res.body.donnees.status).to.equal("picked_up");
  });
}
