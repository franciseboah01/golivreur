meta {
  name: 2. Arrivée chez l'expéditeur
  type: http
  seq: 2
}

post {
  url: {{base_url}}/driver/parcels/{{parcel_id}}/at-sender
  auth: bearer
}

auth:bearer {
  token: {{jwt_token_driver}}
}

assert {
  res.status: eq 200
  res.body.succes: eq true
}

tests {
  test("Statut passe à at_sender", function() {
    expect(res.body.donnees.status).to.equal("at_sender");
  });
}
