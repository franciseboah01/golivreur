meta {
  name: 3. Photo de ramassage (obligatoire)
  type: http
  seq: 3
}

post {
  url: {{base_url}}/parcels/{{parcel_id}}/photo
  body: multipartForm
  auth: bearer
}

auth:bearer {
  token: {{jwt_token_driver}}
}

body:multipart-form {
  type: pickup
  photo: @file(./fixtures/photo_colis_test.jpg)
}

assert {
  res.status: eq 201
  res.body.succes: eq true
}

tests {
  test("photo_url retournée", function() {
    expect(res.body.donnees.photo_url).to.be.a("string");
  });
}

docs {
  ⚠️ Placez un fichier `photo_colis_test.jpg` dans le dossier
  `bruno/driver/gocolis/fixtures/` avant d'exécuter cette requête.
  N'importe quelle image JPEG fonctionne pour les tests.

  Cette photo est OBLIGATOIRE avant de pouvoir valider le code expéditeur.
}
