meta {
  name: 1. Créer une expédition GoColis
  type: http
  seq: 1
}

post {
  url: {{base_url}}/client/parcels
  body: json
  auth: bearer
}

auth:bearer {
  token: {{jwt_token_client}}
}

body:json {
  {
    "recipient_name": "Koné Mariam",
    "recipient_phone": "0709000001",
    "delivery_address": "Quartier Résidentiel, près du lycée moderne, Daloa",
    "delivery_lat": 6.8800,
    "delivery_lng": -6.4510,
    "pickup_address": "Marché Central, Daloa",
    "pickup_lat": 6.8821,
    "pickup_lng": -6.4478,
    "size": "moyen",
    "weight_kg": 3.5,
    "declared_value": 25000,
    "description": "Vêtements et chaussures pour enfant",
    "payment_method": "orange_money",
    "distance_km": 3.5
  }
}

assert {
  res.status: eq 201
  res.body.succes: eq true
}

script:post-response {
  if (res.body.succes) {
    bru.setEnvVar("parcel_id", res.body.donnees.id);
    console.log("✅ Expédition #" + res.body.donnees.id + " créée");
    console.log("📋 Code expéditeur (à conserver) : " + res.body.donnees.sender_code_plain);
  }
}

tests {
  test("Expédition créée avec un sender_code en clair", function() {
    expect(res.body.donnees.sender_code_plain).to.be.a("string");
    expect(res.body.donnees.sender_code_plain.length).to.equal(4);
  });

  test("Assurance calculée automatiquement (valeur > 20000)", function() {
    expect(res.body.donnees.has_insurance).to.equal(true);
  });

  test("Le code recipient n'apparaît JAMAIS dans la réponse", function() {
    const bodyStr = JSON.stringify(res.body);
    expect(bodyStr).to.not.include("recipient_code");
  });
}

docs {
  # Créer une expédition GoColis

  ⚠️ **Important pour les tests :** Cette requête génère des codes ALÉATOIRES
  en base de données réelle. Pour reproduire EXACTEMENT le comportement
  du mock Flutter (codes 7291 / 3847), utilisez plutôt l'environnement
  de test avec des données fixtures, ou notez le `sender_code_plain`
  retourné ici et utilisez-le dans les requêtes suivantes.

  Le code destinataire est envoyé par SMS au 0709000001 — en développement
  local, consultez les logs Laravel ou Tinker pour le récupérer :

  ```bash
  docker compose exec golivreur_app php artisan tinker
  >>> $p = App\Models\Parcel::latest()->first();
  >>> // Le recipient_code est hashé — utilisez plutôt les logs SMS
  ```
}
