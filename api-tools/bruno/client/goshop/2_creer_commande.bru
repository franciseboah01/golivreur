meta {
  name: 2. Créer une commande GoShop
  type: http
  seq: 2
}

post {
  url: {{base_url}}/client/orders
  body: json
  auth: bearer
}

auth:bearer {
  token: {{jwt_token_client}}
}

body:json {
  {
    "merchant_id": {{merchant_id}},
    "items": [
      { "product_id": 1, "quantity": 2 },
      { "product_id": 3, "quantity": 1 }
    ],
    "delivery_address": "Quartier Commerce, près de la pharmacie centrale, Daloa",
    "delivery_lat": 6.8800,
    "delivery_lng": -6.4510,
    "payment_method": "cash",
    "special_instructions": "Sonner deux fois, le portail grince.",
    "distance_km": 2.5
  }
}

assert {
  res.status: eq 201
  res.body.succes: eq true
}

script:post-response {
  if (res.body.succes) {
    bru.setEnvVar("order_id", res.body.donnees.id);
    console.log("✅ Commande #" + res.body.donnees.id + " créée");
  }
}

tests {
  test("Commande créée avec statut pending", function() {
    expect(res.body.donnees.status).to.equal("pending");
  });

  test("Le total inclut produits + livraison", function() {
    expect(res.body.donnees).to.have.property("products_total");
    expect(res.body.donnees).to.have.property("delivery_fee");
  });

  test("Un code de confirmation a été généré", function() {
    expect(res.body.donnees.confirmation_code).to.be.a("string");
    expect(res.body.donnees.confirmation_code.length).to.equal(4);
  });
}

docs {
  Crée une commande GoShop avec 2 produits du Maquis Chez Tantie Adjoua.
  Le merchant_id 1 et product_id 1/3 correspondent aux données du seeder.

  Le code de confirmation généré est à utiliser dans
  "driver/goshop/3_verifier_code.bru" pour simuler la livraison.
}
