meta {
  name: 3. Connexion Client (seeder)
  type: http
  seq: 3
}

post {
  url: {{base_url}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "phone": "{{phone_client}}"
  }
}

assert {
  res.status: eq 200
  res.body.succes: eq true
}

docs {
  # Connexion — Étape 1 (compte du seeder)

